{
  "name": "crucix",
  "version": "2.46.0",
  "description": "Local intelligence engine - 73 OSINT adapters, live dashboard, bounded requests, optional local or cloud AI.",
  "type": "module",
  "bin": {
    "crucix": "scripts/cli.mjs"
  },
  "files": [
    "apis/",
    "lib/",
    "data/",
    "dashboard/",
    "locales/",
    "scripts/",
    "!scripts/build-exe.mjs",
    "!scripts/verify-exe.mjs",
    "!scripts/install-local.mjs",
    "!scripts/publish-npm.mjs",
    "!scripts/*.py",
    "!scripts/*-qa.mjs",
    "!scripts/build-sites.mjs",
    "!scripts/bundle-dashboard-assets.mjs",
    "!**/.env",
    "!**/.env.*.local",
    "!**/*.pem",
    "!**/*.key",
    "!**/*.bak",
    "!**/*.tmp",
    "server.mjs",
    "crucix.config.mjs",
    "diag.mjs",
    ".env.example"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/arlinamid/Crucix.git"
  },
  "scripts": {
    "test": "node --import ./test/isolate-profile.mjs --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "start": "node server.mjs",
    "dev": "node --trace-warnings server.mjs",
    "daemon": "node server.mjs --headless",
    "collector": "node scripts/cli.mjs --collector",
    "status": "node scripts/status.mjs",
    "setup": "node scripts/setup.mjs",
    "cli": "node scripts/cli.mjs",
    "build:exe": "node scripts/build-exe.mjs",
    "verify:exe": "node scripts/verify-exe.mjs",
    "install:local": "node scripts/install-local.mjs",
    "publish:manual": "node scripts/publish-npm.mjs --manual",
    "pack:audit": "node scripts/publish-npm.mjs --dry-run",
    "benchmark:rss": "node scripts/benchmark-world-rss.mjs",
    "sweep": "node apis/briefing.mjs",
    "inject": "node dashboard/inject.mjs",
    "brief": "node apis/briefing.mjs",
    "brief:save": "node apis/save-briefing.mjs",
    "diag": "node diag.mjs",
    "clean": "node scripts/clean.mjs",
    "fresh-start": "npm run clean && npm start"
  },
  "keywords": [
    "osint",
    "intelligence",
    "dashboard",
    "geopolitical"
  ],
  "author": "Crucix",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=22.13",
    "npm": ">=10"
  },
  "dependencies": {
    "express": "^5.1.0",
    "fast-xml-parser": "5.11.2",
    "h3-js": "^4.5.0"
  },
  "optionalDependencies": {
    "discord.js": "^14.26.4"
  },
  "overrides": {
    "undici": "^7.24.4"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
